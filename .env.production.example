# PRODUCTION TEMPLATE — NOT READY TO DEPLOY
# Replace every blank value with freshly rotated production credentials.
# Do not upload this template as-is. Keep payment transfers disabled until the
# Bangkok Bank PromptPay receiver is confirmed and EasySlip v2 is registered/tested.

# Application
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME="Blu Fitness"

# Dedicated PRODUCTION Neon database; never reuse the UAT/local database URL.
DATABASE_URL=

# Cloudinary production account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ThaiBulkSMS production credentials (optional until OTP production acceptance)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NAME=Blufit1

# LINE Messaging API (optional if expiry notifications are enabled)
LINE_CHANNEL_ACCESS_TOKEN=

# EasySlip v2 — issue/rotate production credentials and register the receiving account.
EASYSLIP_V2_API_KEY=
EASYSLIP_PAYMENT_V2_API_KEY=

# Bangkok Bank receiving account; enter the verified full account/name in Vercel.
PAYMENT_RECEIVER_BANK_CODE=002
PAYMENT_RECEIVER_BANK_ACCOUNT=
PAYMENT_RECEIVER_NAME=
# Enter only the PromptPay ID confirmed as linked to this Bangkok Bank account.
PAYMENT_PROMPTPAY_MOBILE=
PAYMENT_PROVIDER_STRATEGY=EASYSLIP_V2_REGISTERED_ACCOUNT
PAYMENT_TRANSFERS_ENABLED=false

# Keep this constant for the installed kiosk station unless intentionally reconfigured.
KIOSK_STATION_ID=LOCAL_FRONT_DESK
