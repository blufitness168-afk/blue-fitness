# ==============================================================================
# 🏋️‍♂️ BLU FITNESS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# ก๊อปปี้ไฟล์นี้เป็น .env.local แล้วกรอกค่าจริงสำหรับใช้งาน
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. Application URL & General Config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=

# ------------------------------------------------------------------------------
# 🐘 2. Neon Database (PostgreSQL Serverless)
# ------------------------------------------------------------------------------
# รับได้จาก Dashboard ของ Neon (https://console.neon.tech)
# รูปแบบ: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# ☁️ 3. Cloudinary (Media Storage สำหรับรูปโปรไฟล์และรูปสลิป)
# ------------------------------------------------------------------------------
# รับได้จาก Dashboard ของ Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 🧾 4. EasySlip API (ระบบตรวจสอบสลิปโอนเงิน PromptPay อัตโนมัติ)
# ------------------------------------------------------------------------------
# รับได้จาก EasySlip Dashboard (https://easyslip.com)
EASYSLIP_API_KEY=

# ข้อมูลบัญชีรับเงินของฟิตเนสสำหรับ Cross-check สลิป (เบอร์ PromptPay หรือเลขบัญชี)
PROMPTPAY_RECEIVER_ACCOUNT=
PROMPTPAY_RECEIVER_NAME=

# ------------------------------------------------------------------------------
# 📱 5. SMS Gateway (สำหรับส่ง OTP ยืนยันเบอร์โทรศัพท์ตอนสมัครสมาชิก)
# ------------------------------------------------------------------------------
# รองรับบริการ SMS เช่น SMSPusher / ThaiBulkSMS
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NAME=

# ------------------------------------------------------------------------------
# 💬 6. LINE Official Account (LINE Messaging API)
# ------------------------------------------------------------------------------
# รับได้จาก LINE Developers Console (Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ------------------------------------------------------------------------------
# 🔒 7. Authentication & Security
# ------------------------------------------------------------------------------
# สุ่มคีย์ความยาว 32+ ตัวอักษรสำหรับ Sign JWT Session ของสมาชิก
JWT_SECRET=

# รหัสผ่านหรือ PIN สำหรับเข้าใช้งานระบบแอดมินหลังบ้าน
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# ⏱️ 8. Background Cron & Hardware Scanner Access
# ------------------------------------------------------------------------------
# Key สำหรับป้องกันไม่ให้คนอื่นยิงเรียก API Cron เตือนวันหมดอายุ (/api/cron/check-expiry)
CRON_SECRET=

# Key สำหรับเครื่องสแกนบาร์โค้ดฮาร์ดแวร์ / ประตูอัตโนมัติ ยิงเข้ามาที่ API (/api/access/checkin)
SCANNER_API_KEY=
PAYMENT_PROMPTPAY_MOBILE="0973355322"
PAYMENT_RECEIVER_NAME="นาย ณัฐนที รุ่งทองใบสุรีย์"
PAYMENT_RECEIVER_BANK_CODE="004"
PAYMENT_RECEIVER_BANK_ACCOUNT="0528938965"
PAYMENT_TRANSFERS_ENABLED=false
PAYMENT_RECEIVER_CONTRACT=
EASYSLIP_V2_API_KEY=
